DEPLOY_HOST=203.0.113.10
DEPLOY_USER=deploy
# Use one authentication method:
DEPLOY_SSH_KEY=/home/you/.ssh/id_ed25519
# DEPLOY_SSH_PASSWORD=

# Absolute WSL path to a secret env file containing Spring Boot variables.
DEPLOY_ENV_FILE=/home/you/project-management-backend.env
DEPLOY_RESET_DATABASE=true
BACKEND_DOMAIN=pms.backend.20030.xyz
REMOTE_APP_DIR=/opt/project-management
DEPLOY_DATABASE_MODE=podman
DEPLOY_DB_NAME=project_management
DEPLOY_DB_USER=app
DEPLOY_DB_PASSWORD=replace-with-database-password
DEPLOY_DB_ROOT_PASSWORD=replace-with-root-password
# Destructive: set true only when you explicitly want to drop and recreate
# the application database during deployment.
DEPLOY_RESET_DATABASE=false
# Required only when DEPLOY_DATABASE_MODE=external.
# DEPLOY_EXTERNAL_DATABASE_URL=jdbc:mysql://db.example:3306/project_management
